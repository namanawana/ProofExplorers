{
  "name": "proof-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive proof IDE / debugger for large Lean 4 developments",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p apps/backend/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --root apps/backend",
    "build": "npm --workspace apps/web run build",
    "dev:backend": "tsx watch apps/backend/src/server.ts",
    "dev:web": "npm --workspace apps/web run dev",
    "dev": "node scripts/dev.mjs",
    "setup:lean": "node scripts/setup-lean.mjs"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  }
}
